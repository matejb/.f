# -*- mode: snippet -*-
# name: test: check error matches expected
# key: tec
# --
switch {
case ${1:err} != nil && ${2:tc.expectedErr} == nil:
	t.Fatalf("unexpected error: %v", $1)
case $1 == nil && $2 != nil:
	t.Fatalf("expected error %v but got nil", $2)
case $1 != nil && $2 != nil && !strings.Contains($1.Error(), $2.Error()):
	t.Fatalf("expected error %v but got %v", $2, $1)
}